<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RisaleEzanVakti" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/titleTextColor</item>
    <item name="colorSecondary">@color/titleTextColor</item>
    <item name="colorPrimaryContainer">@color/titleTextColor</item>
</style>

    <style name="PermissionButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:backgroundTint">@color/titleTextColor</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="android:textAlignment">textStart</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/white</item>
    </style>
</resources>