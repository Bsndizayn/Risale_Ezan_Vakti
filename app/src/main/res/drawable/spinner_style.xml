<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient ile bordo arka plan -->
    <gradient
        android:startColor="#5a0908"
        android:endColor="#7a0f10"
        android:angle="270"/>

    <!-- Köşeler -->
    <corners android:radius="20dp"/>

    <!-- Altın kenarlık -->
    <stroke
        android:width="1dp"
        android:color="#FAEB9C"/>

    <!-- İçerik padding -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp"/>
</shape>
